# Public URL of the site (canonical URLs, sitemap, share images)
NEXT_PUBLIC_SITE_URL=https://tag.bet

# Yandex.Metrika counter id. Loads only after the visitor accepts cookies.
NEXT_PUBLIC_YM_ID=

# ---- Partner links and ad marking (38-ФЗ «О рекламе», ст. 18.1) ----
# For each bookmaker set all three, otherwise the site shows a review link instead of an ad:
#   AFF_<SLUG>  — tracking link from the partner programme (a sub-id is appended automatically)
#   ERID_<SLUG> — ad token issued through the ad data operator (ОРД)
#   ADV_<SLUG>  — advertiser details shown next to the ad, e.g.: ООО «Название», ИНН 0000000000
# Slugs: FONBET, WINLINE, PARI, BETBOOM, LIGASTAVOK, MARATHON, OLIMPBET, BETCITY
AFF_FONBET=
ERID_FONBET=
ADV_FONBET=

# Optional: every partner click is POSTed here as JSON (Google Sheets via Apps Script, Make, your DB...)
CLICK_WEBHOOK_URL=

# ---- Match data: sstats.net (free football API, 30 req/min per IP without a key) ----
# Optional API key from sstats.net raises the limits
SSTATS_API_KEY=
# Extra sstats league ids to show besides the built-in top leagues (comma separated)
SSTATS_LEAGUE_IDS=

# ---- Team and player stats (comparisons, "who can score") ----
# Each finished game is fetched once from /Games/{id} and kept on disk here (default .data/games)
STATS_DIR=
# Requests per minute the stats may use (the key allows 150; the rest is left for the site)
STATS_RATE_PER_MIN=90
# Secret for /api/stats/sync?token=… — call it from cron every 5 minutes to fill whole leagues:
#   */5 * * * * curl -s "https://tag.bet/api/stats/sync?token=…" > /dev/null
STATS_SYNC_TOKEN=
