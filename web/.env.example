# Public URL of the site (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://tag.bet

# App Store link, shown once the iOS app is live
NEXT_PUBLIC_APP_STORE_URL=

# Live odds from https://the-odds-api.com (without it the site uses realistic demo odds)
ODDS_API_KEY=
# How long odds are cached, in seconds (the free tier has 500 requests/month)
ODDS_REVALIDATE_SECONDS=600

# Affiliate tracking links: AFF_<SLUG_IN_UPPER_SNAKE_CASE>
# Paste the exact link from your affiliate dashboard. A sub-id is appended automatically.
AFF_BET365=
AFF_PINNACLE=
AFF_BETFAIR=
AFF_WILLIAM_HILL=
AFF_UNIBET=
AFF_BETWAY=
AFF_888SPORT=
AFF_STAKE=
AFF_1XBET=

# Optional: every affiliate click is POSTed here as JSON (Zapier, Make, Segment, your DB...)
CLICK_WEBHOOK_URL=

# iOS app remote config: countries where bookmaker links are hidden in the app (e.g. during App Review)
APP_LINKS_DISABLED_COUNTRIES=
APP_MIN_VERSION=1.0.0
